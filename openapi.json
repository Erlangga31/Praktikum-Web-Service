{
  "openapi": "3.0.3",
  "info": {
    "title": "Toko API (via Gateway)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Products",
      "description": "Katalog produk dan stok"
    },
    {
      "name": "Orders",
      "description": "Pembuatan dan pembacaan pesanan"
    }
  ],
  "paths": {
    "/product-service/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Daftar semua produk",
        "responses": {
          "200": {
            "description": "Daftar produk",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Batas request gateway terlampaui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/product-service/products/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Detail satu produk",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail produk",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Produk tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Batas request gateway terlampaui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/product-service/products/{id}/reserve": {
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Reservasi stok produk",
        "description": "Mengurangi stok setelah memvalidasi jumlah dan ketersediaan.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stok berhasil dikurangi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "qty tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Produk tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stok tidak cukup",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Batas request gateway terlampaui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/order-service/": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Status Order Service",
        "responses": {
          "200": {
            "description": "Service berjalan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceHealth"
                }
              }
            }
          },
          "429": {
            "description": "Batas request gateway terlampaui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/order-service/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Buat pesanan baru",
        "description": "Mereservasi stok melalui Product Service lalu menyimpan pesanan dan menerbitkan event order.created.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pesanan dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "productId atau qty tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Produk tidak ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stok tidak cukup",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Batas request gateway terlampaui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Respons atau data Product Service tidak valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Product Service tidak tersedia atau timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Daftar semua pesanan",
        "responses": {
          "200": {
            "description": "Daftar pesanan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Batas request gateway terlampaui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "price",
          "stock"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Keripik Tempe"
          },
          "category": {
            "type": "string",
            "example": "Makanan ringan"
          },
          "price": {
            "type": "integer",
            "example": 15000
          },
          "stock": {
            "type": "integer",
            "example": 10
          }
        }
      },
      "ReserveRequest": {
        "type": "object",
        "required": [
          "qty"
        ],
        "properties": {
          "qty": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "Stok tidak cukup"
          }
        }
      },
      "OrderRequest": {
        "type": "object",
        "required": [
          "productId",
          "qty"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "productId",
          "productName",
          "qty",
          "total",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "productId": {
            "type": "integer",
            "example": 1
          },
          "productName": {
            "type": "string",
            "example": "Keripik Tempe"
          },
          "qty": {
            "type": "integer",
            "example": 2
          },
          "total": {
            "type": "integer",
            "example": 30000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-11T10:00:00.000Z"
          }
        }
      },
      "ServiceHealth": {
        "type": "object",
        "required": [
          "service",
          "status"
        ],
        "properties": {
          "service": {
            "type": "string",
            "example": "order-service"
          },
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      }
    }
  }
}
