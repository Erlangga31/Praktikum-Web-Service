{
  "name": "lab08",
  "version": "1.0.0",
  "private": true,
  "description": "Mock catalog and order services for the Lab 08 API gateway",
  "main": "mock-service.js",
  "scripts": {
    "start:catalog": "node mock-service.js catalog 3000",
    "start:order": "node mock-service.js order 3001",
    "start:product": "npm --prefix product-service start",
    "start:orders": "npm --prefix order-service start",
    "start:notifications": "npm --prefix notification-service start",
    "start:notifications:crash": "npm --prefix notification-service run start:crash",
    "start:gateway": "npm --prefix gateway start",
    "test:rate-limit": "node test-rate-limit.js",
    "smoke-test": "node smoke-test.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
